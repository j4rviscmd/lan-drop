{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lan-drop",
  "version": "1.2.0",
  "identifier": "app.lan-drop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "lan-drop",
        "width": 1080,
        "height": 720,
        "resizable": true,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMjBDNjhFQjhGNkQwRkYKUldULzBQYTRqc1lnTHhwVFVQdnNrYmxJSVJuUzE1TWtYSlpERjArSjVoRFNLT3owVEl2eHdiZnQK",
      "endpoints": [
        "https://github.com/j4rviscmd/lan-drop/releases/latest/download/latest.json"
      ]
    }
  }
}
